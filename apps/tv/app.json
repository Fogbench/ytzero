{
  "expo": {
    "name": "YT Zero",
    "slug": "ytzero-tv",
    "version": "0.1.0",
    "orientation": "landscape",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#050506",
    "icon": "./assets/brand/launcher-icon.png",
    "scheme": "ytzero",
    "experiments": {
      "reactCompiler": true
    },
    "ios": {
      "bundleIdentifier": "app.ytzero.tv",
      "entitlements": {
        "com.apple.developer.user-management": ["runs-as-current-user-with-user-independent-keychain"]
      },
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSBonjourServices": [
          "_ytzero._tcp"
        ],
        "NSLocalNetworkUsageDescription": "YT Zero finds your server on the local network so you can connect this television without typing an address."
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.ytzero.tv",
      "versionCode": 1,
      "userInterfaceStyle": "dark"
    },
    "plugins": [
      [
        "@react-native-tvos/config-tv",
        {
          "isTV": true,
          "androidTVRequired": true,
          "tvosDeploymentTarget": "17.0",
          "androidTVBanner": "./assets/brand/android-tv-banner.png",
          "androidTVIcon": "./assets/brand/launcher-icon.png",
          "appleTVImages": {
            "icon": "./assets/brand/tvos-icon-large.png",
            "iconSmall": "./assets/brand/tvos-icon-small.png",
            "iconSmall2x": "./assets/brand/tvos-icon-small@2x.png",
            "topShelf": "./assets/brand/tvos-top-shelf.png",
            "topShelf2x": "./assets/brand/tvos-top-shelf@2x.png",
            "topShelfWide": "./assets/brand/tvos-top-shelf-wide.png",
            "topShelfWide2x": "./assets/brand/tvos-top-shelf-wide@2x.png"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ]
    ],
    "locales": {
      "en": "./locales/en.json",
      "pl": "./locales/pl.json",
      "de": "./locales/de.json",
      "fr": "./locales/fr.json",
      "es": "./locales/es.json",
      "pt-BR": "./locales/pt-BR.json",
      "ru": "./locales/ru.json",
      "ja": "./locales/ja.json",
      "hu": "./locales/hu.json"
    }
  }
}
